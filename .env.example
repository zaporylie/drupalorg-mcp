# Copy to .env and fill in. .env is gitignored.
# docker-compose.yml reads these both for its own ${VAR} interpolation
# (domain in the Traefik labels) and as container env (env_file).

# Public hostname this service is reached at. Feeds the Traefik router's
# Host() rule and MCP_ALLOWED_HOSTS (Host-header validation, not auth).
DOMAIN=mcp.yourdomain.tld

# Your Traefik HTTPS entrypoint and certresolver names.
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
